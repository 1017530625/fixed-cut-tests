import ProofBench.PROBLEMS.P118.CutRequirements

/-! A kernel-checked certificate of incidence of all 127 unordered, proper corner cuts.
Bit j represents the alternating matching with the frozen index j, and bit 0 of each
corner-side mask is zero because the representative excludes corner 000. -/
namespace CornerArbitraryCuts.SignatureTable

open Finset CornerLemma

set_option maxRecDepth 30000
set_option maxHeartbeats 6000000

private def vertexNumber (v : Vertex) : Nat :=
  4 * (v 0).toNat + 2 * (v 1).toNat + (v 2).toNat

/-- Cut number i is the side with the eight-bit characteristic mask 2(i+1). -/
def numberedSide (i : Fin 127) : Finset Vertex :=
  univ.filter fun v => (2 * (i.val + 1)).testBit (vertexNumber v)

private def numberOf (A : Finset Vertex) : Nat :=
  ∑ v ∈ A, 2 ^ vertexNumber v

private theorem numberOf_numberedSide : ∀ i : Fin 127,
    numberOf (numberedSide i) = 2 * (i.val + 1) := by decide

def sideEmbedding : Fin 127 ↪ Finset Vertex where
  toFun := numberedSide
  inj' := by
    intro i j h
    have hn := congrArg numberOf h
    rw [numberOf_numberedSide, numberOf_numberedSide] at hn
    exact Fin.ext (by omega)

theorem canonical_numberedSide : ∀ i : Fin 127,
    (numberedSide i).Nonempty ∧ (fun _ : Fin 3 => false) ∉ numberedSide i := by decide

/-- Column j of this row records membership in the frozen detected set. -/
def signatureMask (i : Fin 127) : Nat :=
  (#[
    0x00, 0x00, 0x00, 0x00, 0x21, 0x0A, 0x28, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x82, 0x00, 0x00, 0x00, 0xA0, 0x00, 0x22, 0x05,
    0x84, 0x00, 0x00, 0x00, 0x81, 0x00, 0x00, 0x00, 0x00, 0x41, 0x00, 0x00,
    0x00, 0x48, 0x09, 0x12, 0x00, 0x50, 0x00, 0x00, 0x00, 0x42, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x14, 0x06, 0x11, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x14, 0x05, 0x12, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x48, 0x0A, 0x00, 0x00, 0x50,
    0x00, 0x18, 0x0A, 0x41, 0x00, 0x00, 0x00, 0x44, 0x05, 0x00, 0x00, 0xA0,
    0x00, 0x21, 0x00, 0x84, 0x24, 0x00, 0x21, 0x82, 0x00, 0x00, 0x00, 0x90,
    0x00, 0x12, 0x00, 0x28, 0x88, 0x60, 0x00, 0x00, 0xA0, 0x48, 0x28, 0x00,
    0x82, 0x41, 0x00, 0x14, 0x84, 0x50, 0x00 ] : Array Nat)[i.val]!

theorem mask_correct : ∀ (i : Fin 127) (j : Fin 8),
    j ∈ detected (numberedSide i) ↔ (signatureMask i).testBit j.val = true := by decide

/-- Repeated entries record distinct canonical cuts with the same witness pair. -/
def maskHistogram : Multiset Nat :=
  Multiset.replicate 79 0 + (([
    0x05, 0x05, 0x05, 0x09, 0x11, 0x21, 0x21, 0x21, 0x41, 0x41, 0x41, 0x81,
    0x06, 0x0A, 0x0A, 0x0A, 0x12, 0x12, 0x12, 0x22, 0x42, 0x82, 0x82, 0x82,
    0x14, 0x14, 0x14, 0x24, 0x44, 0x84, 0x84, 0x84, 0x18, 0x28, 0x28, 0x28,
    0x48, 0x48, 0x48, 0x88, 0x50, 0x50, 0x50, 0x90, 0x60, 0xA0, 0xA0, 0xA0 ] : List Nat) : Multiset Nat)

theorem mask_histogram :
    ((univ : Finset (Fin 127)).val.map signatureMask) = maskHistogram := by decide

#print axioms mask_correct
#print axioms mask_histogram

end CornerArbitraryCuts.SignatureTable
