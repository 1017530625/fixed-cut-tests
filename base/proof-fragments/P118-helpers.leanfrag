    all_goals first | rw [ite_eq_left (by decide)] | rw [ite_eq_right (by decide)]
    all_goals assumption
private theorem case4 (lam : Face → Nat) (k : Nat) (R : Finset Vertex)
    (hc : ∀ i : Fin 3, cutValue lam (univ.filter fun v => v i = false) = k)
    (hh : ∀ A : Finset Vertex, (∃ r ∈ R, r ∈ A) →
      (∃ r ∈ R, r ∉ A) → k ≤ cutValue lam A)
    (r0 : v0 ∈ R) (r1 : v1 ∈ R) (r3 : v3 ∈ R) (r4 : v4 ∈ R) (r6 : v6 ∈ R) (r7 : v7 ∈ R) : IsFlower lam k := by
  have c0 := hc 0
  rw [coord0] at c0
  have c1 := hc 1
  rw [coord1] at c1
  have c2 := hc 2
  rw [coord2] at c2
  have hatomic0 := hh {v0} ⟨v0, r0, by decide⟩ ⟨v1, r1, by decide⟩
  rw [atomic0] at hatomic0
  have hatomic1 := hh {v1} ⟨v1, r1, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic1] at hatomic1
  have hatomic3 := hh {v3} ⟨v3, r3, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic3] at hatomic3
  have hatomic4 := hh {v4} ⟨v4, r4, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic4] at hatomic4
  have hatomic6 := hh {v6} ⟨v6, r6, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic6] at hatomic6
  have hatomic7 := hh {v7} ⟨v7, r7, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic7] at hatomic7
  have hpair01 := hh {v0, v1} ⟨v0, r0, by decide⟩ ⟨v3, r3, by decide⟩
  rw [pair01] at hpair01
  have hpair04 := hh {v0, v4} ⟨v0, r0, by decide⟩ ⟨v1, r1, by decide⟩
  rw [pair04] at hpair04
  have coords := congrArg₂ (· + ·) (congrArg₂ (· + ·) c0 c1) c2
  have atoms := (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add hatomic0 hatomic1) hatomic3) hatomic4) hatomic6) hatomic7)
  obtain ⟨zeroTotal, balance⟩ := cycleCounts (lam fxxx) (lam f0xx + lam f1xx + lam fx0x + lam fx1x + lam fxx0 + lam fxx1) (lam f00x + lam f0x1 + lam f11x + lam f1x0 + lam fx00 + lam fx11) (lam f01x + lam f0x0 + lam f10x + lam f1x1 + lam fx01 + lam fx10) k (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 atoms; omega) (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords; omega)
  have zf0xx : lam f0xx = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance; omega
  have zf1xx : lam f1xx = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx; omega
  have zfx0x : lam fx0x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx; omega
  have zfx1x : lam fx1x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x; omega
  have zfxx0 : lam fxx0 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x; omega
  have zfxx1 : lam fxx1 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0; omega
  have zf01x : lam f01x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1; omega
  have zf0x0 : lam f0x0 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x; omega
  have zf10x : lam f10x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0; omega
  have zf1x1 : lam f1x1 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x; omega
  have zfx01 : lam fx01 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1; omega
  have zfx10 : lam fx10 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01; omega
  simp only [zf0x0, zf0xx, zfx0x, zfxx0, Nat.zero_add] at hatomic0
  simp only [zf0xx, zfx01, zfx0x, zfxx1, Nat.zero_add] at hatomic1
  simp only [zf01x, zf0xx, zfx1x, zfxx1, Nat.zero_add] at hatomic3
  simp only [zf10x, zf1xx, zfx0x, zfxx0, Nat.zero_add] at hatomic4
  simp only [zf1xx, zfx10, zfx1x, zfxx0, Nat.zero_add] at hatomic6
  simp only [zf1x1, zf1xx, zfx1x, zfxx1, Nat.zero_add] at hatomic7
  simp only [zf0x0, zf0xx, zfx01, zfx0x, zfxx0, zfxx1, Nat.zero_add] at hpair01
  simp only [zf0x0, zf0xx, zf10x, zf1xx, zfx0x, zfxx0, Nat.zero_add] at hpair04
  obtain ⟨s0,s1,s2,s3,s4,s5⟩ := tightSix k _ _ _ _ _ _ hatomic0 hatomic1 hatomic3 hatomic7 hatomic6 hatomic4 (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10; omega)
  obtain ⟨eq1,eq2,eq3,eq4,eq5,bound,full⟩ := equalWeights (lam fxxx) k (lam f00x) (lam f0x1) (lam fx11) (lam f11x) (lam f1x0) (lam fx00)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s1 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s2 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s2 s3 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s2 s3 s4; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair04 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic3 hatomic4 hatomic6 hatomic7 hpair01 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x0 zf10x zf1x1 zfx01 zfx10 s0 s1 s2 s3 s4 s5; omega)
  refine ⟨?_, v2, lam f00x, ?_, ?_, ?_⟩
  · intro f h
    rcases dimension2 f h with rfl | rfl | rfl | rfl | rfl | rfl <;> assumption
  · exact bound
  · exact full
  · intro f h
    rcases dimension1 f h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    all_goals first | rw [ite_eq_left (by decide)] | rw [ite_eq_right (by decide)]
    all_goals assumption
private theorem case5 (lam : Face → Nat) (k : Nat) (R : Finset Vertex)
    (hc : ∀ i : Fin 3, cutValue lam (univ.filter fun v => v i = false) = k)
    (hh : ∀ A : Finset Vertex, (∃ r ∈ R, r ∈ A) →
      (∃ r ∈ R, r ∉ A) → k ≤ cutValue lam A)
    (r0 : v0 ∈ R) (r1 : v1 ∈ R) (r2 : v2 ∈ R) (r5 : v5 ∈ R) (r6 : v6 ∈ R) (r7 : v7 ∈ R) : IsFlower lam k := by
  have c0 := hc 0
  rw [coord0] at c0
  have c1 := hc 1
  rw [coord1] at c1
  have c2 := hc 2
  rw [coord2] at c2
  have hatomic0 := hh {v0} ⟨v0, r0, by decide⟩ ⟨v1, r1, by decide⟩
  rw [atomic0] at hatomic0
  have hatomic1 := hh {v1} ⟨v1, r1, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic1] at hatomic1
  have hatomic2 := hh {v2} ⟨v2, r2, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic2] at hatomic2
  have hatomic5 := hh {v5} ⟨v5, r5, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic5] at hatomic5
  have hatomic6 := hh {v6} ⟨v6, r6, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic6] at hatomic6
  have hatomic7 := hh {v7} ⟨v7, r7, by decide⟩ ⟨v0, r0, by decide⟩
  rw [atomic7] at hatomic7
  have hpair01 := hh {v0, v1} ⟨v0, r0, by decide⟩ ⟨v2, r2, by decide⟩
  rw [pair01] at hpair01
  have hpair02 := hh {v0, v2} ⟨v0, r0, by decide⟩ ⟨v1, r1, by decide⟩
  rw [pair02] at hpair02
  have coords := congrArg₂ (· + ·) (congrArg₂ (· + ·) c0 c1) c2
  have atoms := (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add hatomic0 hatomic1) hatomic2) hatomic5) hatomic6) hatomic7)
  obtain ⟨zeroTotal, balance⟩ := cycleCounts (lam fxxx) (lam f0xx + lam f1xx + lam fx0x + lam fx1x + lam fxx0 + lam fxx1) (lam f00x + lam f0x0 + lam f11x + lam f1x1 + lam fx01 + lam fx10) (lam f01x + lam f0x1 + lam f10x + lam f1x0 + lam fx00 + lam fx11) k (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 atoms; omega) (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords; omega)
  have zf0xx : lam f0xx = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance; omega
  have zf1xx : lam f1xx = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx; omega
  have zfx0x : lam fx0x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx; omega
  have zfx1x : lam fx1x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x; omega
  have zfxx0 : lam fxx0 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x; omega
  have zfxx1 : lam fxx1 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0; omega
  have zf01x : lam f01x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1; omega
  have zf0x1 : lam f0x1 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x; omega
  have zf10x : lam f10x = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1; omega
  have zf1x0 : lam f1x0 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x; omega
  have zfx00 : lam fx00 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0; omega
  have zfx11 : lam fx11 = 0 := by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00; omega
  simp only [zf0xx, zfx00, zfx0x, zfxx0, Nat.zero_add] at hatomic0
  simp only [zf0x1, zf0xx, zfx0x, zfxx1, Nat.zero_add] at hatomic1
  simp only [zf01x, zf0xx, zfx1x, zfxx0, Nat.zero_add] at hatomic2
  simp only [zf10x, zf1xx, zfx0x, zfxx1, Nat.zero_add] at hatomic5
  simp only [zf1x0, zf1xx, zfx1x, zfxx0, Nat.zero_add] at hatomic6
  simp only [zf1xx, zfx11, zfx1x, zfxx1, Nat.zero_add] at hatomic7
  simp only [zf0x1, zf0xx, zfx00, zfx0x, zfxx0, zfxx1, Nat.zero_add] at hpair01
  simp only [zf01x, zf0xx, zfx00, zfx0x, zfx1x, zfxx0, Nat.zero_add] at hpair02
  obtain ⟨s0,s1,s2,s3,s4,s5⟩ := tightSix k _ _ _ _ _ _ hatomic0 hatomic1 hatomic5 hatomic7 hatomic6 hatomic2 (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11; omega)
  obtain ⟨eq1,eq2,eq3,eq4,eq5,bound,full⟩ := equalWeights (lam fxxx) k (lam f00x) (lam fx01) (lam f1x1) (lam f11x) (lam fx10) (lam f0x0)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s1 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s2 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s2 s3 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s2 s3 s4; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair02 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s2 s3 s4 s5; omega)
    (by clear c0 c1 c2 hatomic0 hatomic1 hatomic2 hatomic5 hatomic6 hatomic7 hpair01 coords atoms zeroTotal balance zf0xx zf1xx zfx0x zfx1x zfxx0 zfxx1 zf01x zf0x1 zf10x zf1x0 zfx00 zfx11 s0 s1 s2 s3 s4 s5; omega)
  refine ⟨?_, v3, lam f00x, ?_, ?_, ?_⟩
  · intro f h
    rcases dimension2 f h with rfl | rfl | rfl | rfl | rfl | rfl <;> assumption
  · exact bound
  · exact full
